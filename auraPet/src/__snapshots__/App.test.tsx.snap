          href="/como-funciona"
        >
          Cómo funciona
        </a>
        <a
          class=""
          data-discover="true"
          href="/veterinarias"
        >
          Para veterinarias
        </a>
        <a
          class=""
          data-discover="true"
          href="/duenos"
        >
          Para dueños
        </a>
        <a
          class=""
          data-discover="true"
          href="/adopta"
        >
          Adopta
        </a>
        <a
          class=""
          data-discover="true"
          href="/urgencias"
        >
          Urgencias
        </a>
        <a
          class=""
          data-discover="true"
          href="/nosotros"
        >
          Nosotros
        </a>
        <a
          class=""
          data-discover="true"
          href="/contacto"
        >
          Contacto
        </a>
      </div>
      <div
        class="landing-footer-col"
      >
        <h4>
          Ayuda
        </h4>
        <a
          data-discover="true"
          href="/contacto"
        >
          Soporte técnico
        </a>
        <a
          data-discover="true"
          href="/como-funciona"
        >
          Preguntas frecuentes
        </a>
      </div>
      <div
        class="landing-footer-col"
      >
        <h4>
          Social
        </h4>
        <div
          class="contacto-footer-social"
        >
          <span>
            facebook
          </span>
          <span>
            instagram
          </span>
          <span>
            twitter
          </span>
          <span>
            youtube
          </span>
        </div>
      </div>
      <div
        class="landing-footer-bottom"
      >
        © auraPet 2026. Derechos Reservados.
      </div>
    </footer>
  </div>
</div>
`;

